generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id             String          @id @default(uuid())
  name           String
  code           String          @unique
  motto          String?
  logoUrl        String?
  emailDomains   String[]
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  auditLogs      AuditLog[]
  classes        Class[]
  csvImports     CsvImport[]
  exams          Exam[]
  parents        Parent[]
  smsLogs        SmsLog[]
  subjects       Subject[]
  terms          Term[]
  timetableSlots TimetableSlot[]
  settings       SchoolSettings?
  syncConflicts  SyncConflict[]
  users          User[]

  @@map("schools")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  fullName         String
  passwordHash     String?
  phoneNumber      String?
  isActive         Boolean           @default(true)
  activatedAt      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  schoolId         String
  activationTokens ActivationToken[]
  auditLogs        AuditLog[]        @relation("UserAuditLogs")
  createdImports   CsvImport[]       @relation("UserCsvImports")
  parentProfile    Parent[]
  refreshTokens    RefreshToken[]
  roles            UserRole[]
  school           School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("users")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model SchoolSettings {
  id            String   @id @default(uuid())
  schoolId      String   @unique
  schoolName    String?
  schoolTag     String?
  schoolAddress String?
  schoolEmail   String?
  schoolWebsite String?
  schoolMotto   String?
  schoolVision  String?
  schoolMission String?
  principalName String?
  principalTitle String?
  academicYear  Int?
  curricula     Json?
  currentTermId String?
  gradingScale  Json?
  smsProvider   String?
  smsSenderId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

model Class {
  id                 String                   @id @default(uuid())
  schoolId           String
  curriculumId       String                   @default("cbc")
  name               String
  level              Int
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  school             School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  exams              Exam[]
  sheets             MarkSheet[]
  streams            Stream[]
  students           Student[]
  timetable          TimetableSlot[]
  teacherAssignments TeacherClassAssignment[]
  @@map("classes")
}

model Stream {
  id        String          @id @default(uuid())
  classId   String
  name      String
  createdAt DateTime        @default(now())
  sheets    MarkSheet[]
  class     Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  students  Student[]
  timetable TimetableSlot[]
  @@map("streams")
}

model Subject {
  id                 String                     @id @default(uuid())
  schoolId           String
  curriculumId       String                     @default("cbc")
  name               String
  code               String
  isCore             Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  sheets             MarkSheet[]
  school             School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetable          TimetableSlot[]
  teacherAssignments TeacherSubjectAssignment[]
  @@map("subjects")
}

model TeacherSubjectAssignment {
  id        String   @id @default(uuid())
  userId    String
  subjectId String
  createdAt DateTime @default(now())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@map("teacher_subject_assignments")
}

model TeacherClassAssignment {
  id             String   @id @default(uuid())
  userId         String
  classId        String
  isClassTeacher Boolean  @default(false)
  createdAt      DateTime @default(now())
  class          Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
  @@map("teacher_class_assignments")
}

model Parent {
  id           String          @id @default(uuid())
  schoolId     String
  userId       String?
  fullName     String?
  email        String?
  relationship String?
  phoneNumbers String[]        @default([])
  createdBy    String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  children     StudentParent[]
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@map("parents")
}

model StudentParent {
  id           String   @id @default(uuid())
  studentId    String
  parentId     String
  relationship String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  parent       Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@map("student_parents")
}

model Student {
  id          String          @id @default(uuid())
  schoolId    String
  admissionNo String
  fullName    String
  gender      String
  dateOfBirth DateTime?
  guardianName String?
  guardianPhone String?
  guardianEmail String?
  classId     String
  streamId    String
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  marks       MarkEntry[]
  class       Class           @relation(fields: [classId], references: [id])
  stream      Stream          @relation(fields: [streamId], references: [id])
  parents     StudentParent[]
  @@map("students")
}

model Term {
  id        String   @id @default(uuid())
  schoolId  String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  exams     Exam[]
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@map("terms")
}

model Exam {
  id          String      @id @default(uuid())
  schoolId    String
  curriculumId String     @default("cbc")
  classId     String
  termId      String
  name        String
  year        Int
  outOf       Int         @default(100)
  status      String      @default("draft")
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  class       Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term        Term        @relation(fields: [termId], references: [id])
  sheets      MarkSheet[]
  @@map("exams")
}

model MarkSheet {
  id        String      @id @default(uuid())
  curriculumId String  @default("cbc")
  examId    String
  classId   String
  streamId  String
  subjectId String
  teacherId String
  status    String      @default("draft")
  locked    Boolean     @default(false)
  comment   String?
  updatedAt DateTime    @default(now()) @updatedAt
  entries   MarkEntry[]
  class     Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  exam      Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  stream    Stream      @relation(fields: [streamId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@map("mark_sheets")
}

model MarkEntry {
  id        String    @id @default(uuid())
  sheetId   String
  studentId String
  score     Int?
  updatedAt DateTime  @default(now()) @updatedAt
  updatedBy String
  sheet     MarkSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@map("mark_entries")
}

model TimetableSlot {
  id        String   @id @default(uuid())
  schoolId  String
  classId   String
  streamId  String?
  dayOfWeek Int
  period    Int
  startTime String
  endTime   String
  subjectId String?
  teacherId String?
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stream    Stream?  @relation(fields: [streamId], references: [id], onDelete: Cascade)
  subject   Subject? @relation(fields: [subjectId], references: [id])
  @@map("timetable_slots")
}

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String
  userId    String
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor     User     @relation("UserAuditLogs", fields: [userId], references: [id])
  @@map("audit_logs")
}

model SmsLog {
  id         String   @id @default(uuid())
  schoolId   String
  recipient  String
  message    String
  provider   String
  status     String
  providerId String?
  error      String?
  sentAt     DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@map("sms_logs")
}

model SyncConflict {
  id             String    @id @default(uuid())
  entity         String
  entityId       String
  field          String
  serverValue    String?
  incomingValue  String?
  incomingBy     String?
  incomingDevice String?
  status         String    @default("pending")
  resolution     String?
  customValue    String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("sync_conflicts")
}

model ActivationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("activation_tokens")
}

model CsvImport {
  id           String   @id @default(uuid())
  schoolId     String
  entity       String
  fileName     String
  importedBy   String
  successCount Int
  failureCount Int
  errors       Json
  createdAt    DateTime @default(now())
  importer     User     @relation("UserCsvImports", fields: [importedBy], references: [id])
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@map("csv_imports")
}

enum Role {
  PLATFORM_ADMIN
  PRINCIPAL
  SENIOR_TEACHER
  TEACHER
  PARENT
  STUDENT
}
