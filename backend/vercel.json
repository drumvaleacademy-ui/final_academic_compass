{
  "version": 2,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run vercel-build",
  "functions": {
    "dist/serverless.mjs": {
      "runtime": "@vercel/node@5.3.0",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "/dist/serverless.mjs" }
  ]
}
