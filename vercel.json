{
  "version": 2,
  "framework": null,
  "installCommand": "pnpm install",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/public" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://api.drumvale-academic-compass.co.ke/api/$1",
      "methods": ["GET", "POST", "PUT", "PATCH", "DELETE"]
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/public/index.html",
      "method": ["GET"]
    }
  ]
}
