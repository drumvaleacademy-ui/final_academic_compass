{
  "version": 2,
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts --filter @workspace/academic-compass...",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/public" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://final-academic-compass-backend.vercel.app/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
